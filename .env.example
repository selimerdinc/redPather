# 🚀 Red Pather - Example Environment Variables

# AI Configuration (Optional)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Jira Configuration (Optional for Crash Detective)
JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_PROJECT="PROJECT_KEY"
JIRA_TOKEN="YOUR_JIRA_API_TOKEN_HERE"

# Device Configuration
ANDROID_DEVICE="emulator-5554"
ANDROID_PKG="com.example.app"
ANDROID_ACT="com.example.app.MainActivity"

# iOS Configuration (macOS only)
IOS_DEVICE="iPhone 15"
IOS_BUNDLE="com.example.app"

# Server Configuration
PORT=5005
HOST=127.0.0.1
DEBUG=False
